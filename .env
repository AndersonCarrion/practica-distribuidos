# ════════════════════════════════════════════════════════════════
#  VARIABLES QUE CAMBIAN EN CADA MÁQUINA
# ════════════════════════════════════════════════════════════════

# Nombre único para identificar este nodo
NODE_NAME=Nodo-A

# IP PROPIA de esta máquina (cambiar en cada PC)
#   PC1 (Nodo-A) → MY_IP=10.2.56.252
#   PC2 (Nodo-B) → MY_IP=10.2.56.109
#   PC3 (Nodo-C) → MY_IP=10.2.56.108
MY_IP=10.2.56.252

# ════════════════════════════════════════════════════════════════
#  VARIABLES COMUNES (iguales en todas las máquinas)
# ════════════════════════════════════════════════════════════════

JWT_SECRET=muraltech_secret_key_prod_cambiar

# IPs de TODAS las máquinas del clúster (igual en todos los .env)
MAQUINA1_IP=10.2.56.252
MAQUINA2_IP=10.2.56.109
MAQUINA3_IP=10.2.56.108   # Comentar si PC3 no está online aún
